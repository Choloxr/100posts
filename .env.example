# --- Supabase (Project Settings → API) ---
# Project URL = URL del proyecto (ej. https://xxxxx.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# anon / public = clave "anon" "legacy" o la que Supabase muestra para el cliente.
# En el JWT dice role "anon". Es segura en el navegador (respeta RLS).
# NO es la "service_role". Suele llamarse "public" o "publishable" en algunos textos.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# service_role = clave SECRETA con privilegios totales (ignora RLS). Solo servidor.
# En Supabase: "service_role" secret. Nunca NEXT_PUBLIC_ ni en el frontend.
SUPABASE_SERVICE_ROLE_KEY=

# --- OpenAI / fal ---
OPENAI_API_KEY=
FAL_KEY=

# Opcional: remove background en producto (fal BiRefNet v2)
ENABLE_PRODUCT_ENHANCEMENT=
